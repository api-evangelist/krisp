        {
          "id": "b925529a-aec5-43d2-addf-15e969359823",
          "name": "Mint a Voice Translation session key",
          "request": {
            "name": "Mint a Voice Translation session key",
            "description": {
              "content": "Exchanges the long-lived account API key for a short-lived session key. The session key is the only credential passed to the streaming WebSocket endpoint, so the account key never has to reach an untrusted client. Mint this on your backend.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "sdk",
                "voice-translation",
                "session",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "expiration_ttl",
                  "value": "<integer>",
                  "description": "Session key lifetime in MINUTES."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "91af3991-1946-4f68-91b8-17f16ce3c7a2",
