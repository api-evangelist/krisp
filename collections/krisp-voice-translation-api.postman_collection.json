          "id": "248215b3-96ed-458f-b6ef-f2bf180857e5",
          "name": "List supported voice translation languages",
          "request": {
            "name": "List supported voice translation languages",
            "description": {
              "content": "Returns the languages currently available for voice translation. Use the returned language_code values as source_language / target_language when starting a session. The list is dynamic — fetch it at session start rather than hard-coding it.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "voice-translation",
                "languages"
              ],
              "host": [
                "{{baseUrl}}"
