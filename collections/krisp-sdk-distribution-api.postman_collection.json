          "name": "Get short-lived download URLs for an SDK version and its models",
          "request": {
            "name": "Get short-lived download URLs for an SDK version and its models",
            "description": {
              "content": "Retrieves temporary download URLs for a specific licensed SDK version and its associated model files, for use in CI/CD pipelines, automated testing workflows, or custom deployment scripts. The returned S3 URLs expire after data.expires_in seconds.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "sdk",
                "versions",
                ":id",
                "download-urls"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "id",
                  "description": "(Required) The unique version ID of the SDK, found in the SDK Dashboard."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
